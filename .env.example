# ==============================================================================
# AI-Powered Online Examination Platform — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local to Git.
# ==============================================================================

# --- Google Gemini AI API Configuration ---
# Obtain your key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Client SDK Configuration (For Google Sign-In) ---
# Obtain from Firebase Console -> Project Settings -> General -> Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- Firebase Admin SDK Configuration (Server-Side Firestore & Auth) ---
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# For the private key, include quotes and literal \n characters (e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n")
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Admin Authentication Configuration ---
# Default initial admin username and password. Change before deploying to production!
ADMIN_USERNAME=sumit045
ADMIN_INITIAL_PASSWORD=sumit045

# --- JWT Session Encryption Secret ---
# Generate a strong 32+ character random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace_with_a_secure_random_32_character_string_for_production
